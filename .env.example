# Copy to .env. All optional.

# desktop | android
PLATFORM=desktop
BASE_URL=https://www.stumbleguys.com
TIMEOUT_SECONDS=20
HEADLESS=false
# red dot showing where the automation clicks (desktop)
SHOW_CURSOR=true
# one video per test in target/artifacts (desktop: terminal needs Screen Recording permission)
RECORD=false
# fixed 1440x900 by default (same layout everywhere); true for a bigger window when recording
WINDOW_MAXIMIZED=false

# empty = start Appium locally
APPIUM_URL=
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
# AVD to boot if no device is running (created by scripts/setup-android.sh)
ANDROID_AVD=sg-pixel
# empty = auto-detect (Homebrew / Android Studio default)
ANDROID_HOME=

# Linked test account saved by AUTH-04, used by AUTH-02 and PUR-01
LINKED_INBOX=.local/linked-inbox.properties
